# Secrets for edge functions on the local stack. Copy to supabase/functions/.env.
# SUPABASE_URL, SUPABASE_ANON_KEY and SUPABASE_SERVICE_ROLE_KEY are provided automatically.

# AI plans and assessment reviews: any OpenAI-compatible chat API
AI_GATEWAY_URL=https://api.openai.com/v1
AI_GATEWAY_API_KEY=
AI_GATEWAY_MODEL=gpt-4o-mini
# Or use the Lovable gateway instead of the three settings above
# LOVABLE_API_KEY=

# Chat (grok-chat, llm-with-failover)
GROK_API_KEY=
OPENAI_API_KEY=

# Family emails
RESEND_API_KEY=

# Scheduled jobs
SCHEDULER_SECRET=
